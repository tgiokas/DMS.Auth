# Keycloak Configuration
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_BASEURL=https://keycloak:8443
KEYCLOAK_REALM=DMSRealm
KEYCLOAK_CLIENTID=auth-app
KEYCLOAK_CLIENTSECRET=rpC8odnaEbiwKKxVwcg8yle2bobgFUA2
KEYCLOAK_AUTHORITY=https://keycloak:8443/realms/DMSRealm
KEYCLOAK_REDIRECTURI=https://localhost/api/auth/authentication/oauth2callback
KC_HOSTNAME=https://localhost/auth
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=false

# Keycloak DB Configuration
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloakdb
KC_DB_USERNAME=keycloakuser
KC_DB_PASSWORD=keycloakpass
KC_DB_POSTGRES_DB=keycloakdb

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123

# Auth DB Configuration
AUTH_DB_POSTGRES_USER=authuser
AUTH_DB_POSTGRES_PASSWORD=authpass
AUTH_DB_POSTGRES_DB=authdb
AUTH_DB_CONNECTION=Host=auth-db;Database=authdb;Username=authuser;Password=authpass;Include Error Detail=true

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka1:9092

# Kafka Producer - Auth Configuration
AUTH_KAFKA_TOPIC=notifications.email.auth
AUTH_KAFKA_RECONNECT_BACKOFF_MS=50
AUTH_KAFKA_RECONNECT_BACKOFF_MAX_MS=10000
AUTH_KAFKA_SOCKET_CONNECTION_SETUP_TIMEOUT_MS=10000
AUTH_KAFKA_SOCKET_TIMEOUT_MS=30000
AUTH_KAFKA_RETRY_BACKOFF_MS=100
AUTH_KAFKA_REQUEST_TIMEOUT_MS=30000
AUTH_KAFKA_MESSAGE_TIMEOUT_MS=120000

# Auth.Api Configuration
FRONTEND_ENTRAID_REDIRECTURI=https://localhost/entra-login
VERIFICATION_URL=https://localhost/verify-email
PASSWORD_RESET_URL=https://localhost/password-reset
PASSWORD_SET_URL=https://localhost/password-set
AUTH_EMAILS_WHITELIST=off
AUTH_MAX_LOGIN_FAILURES=5
AUTH_FAILURE_RESET_TIME_MINS=10
AUTH_LOCK_DURATION_MINS=5

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80